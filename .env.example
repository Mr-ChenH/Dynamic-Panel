# Copy to .env and replace every required value. No production secret has a default.
NODE_ENV=production
HOST=0.0.0.0
PORT=43822
CONSOLE_ORIGIN=https://sync.example.com
TRUST_PROXY=127.0.0.1
COOKIE_SECRET=
KEY_LOOKUP_SECRET=
CURSOR_SECRET=

DP_OBJECT_TARGET=filesystem
DP_OBJECT_PATH=/var/lib/dynamic-panel/objects
DP_BACKUP_TARGET=filesystem
DP_BACKUP_PATH=/var/lib/dynamic-panel/backups
DP_BACKUP_INDEPENDENT_MEDIA=false
DP_BACKUP_MASTER_KEY=
DP_BACKUP_KEY_ID=primary
DP_BACKUP_HOUR_UTC=2
DP_BACKUP_MINUTE_UTC=0

# For direct TLS, remove TRUST_PROXY and configure both files.
# TLS_CERT_FILE=/run/secrets/tls_cert
# TLS_KEY_FILE=/run/secrets/tls_key

# S3 alternatives (credentials use the standard AWS environment/provider chain).
# DP_OBJECT_TARGET=s3
# DP_OBJECT_S3_BUCKET=
# DP_OBJECT_S3_REGION=us-east-1
# DP_OBJECT_S3_ENDPOINT=https://s3.example.com
# DP_BACKUP_TARGET=s3
# DP_BACKUP_S3_BUCKET=
# DP_BACKUP_S3_REGION=us-east-1
# DP_BACKUP_S3_ENDPOINT=https://s3.example.com
